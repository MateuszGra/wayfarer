PORT=3000
DATABASE_URL=postgres://wayfarer:wayfarer@localhost:5432/wayfarer
TEST_DATABASE_URL=postgres://wayfarer:wayfarer@localhost:5432/wayfarer_test
# Local development runs over plain http, where a Secure cookie would never be sent back.
SESSION_COOKIE_SECURE=false
# Set to true only behind a reverse proxy (Passenger on MyDevil), which sets X-Forwarded-For.
TRUST_PROXY=false
# Local development only: uncomment to let the password "localhost" sign in with any address. The server
# refuses to start with it in production (NODE_ENV=production, Secure cookies or TRUST_PROXY=true).
# DEV_LOGIN=true

# Outgoing e-mail for step reminders (`npm run reminders:send`). Leave unset locally unless you want to
# send real mail; in production they are in .env.production.
# SMTP_HOST=mail23.mydevil.net
# SMTP_PORT=465
# SMTP_USER=noreply@mgrabowski.eu
# SMTP_PASSWORD=
# MAIL_FROM="Wayfarer <noreply@mgrabowski.eu>"
# APP_URL=http://localhost:5173
